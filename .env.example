# OmoNETAB environment variables
# Copy this file to .env.local for local development. Never commit real credentials.

# ------------------------------------------------------------------
# Data mode
# ------------------------------------------------------------------
# "demo"     -> in-memory demo data, no credentials needed
# "supabase" -> real Supabase Postgres + Supabase Auth (requires both keys below)
# There is no silent fallback: DATA_MODE=supabase without credentials fails the
# first request that touches data rather than showing demo records. The check
# runs when the Supabase client is built (per request), not when the server
# boots, so a misconfigured deployment returns errors instead of starting clean.
DATA_MODE=demo

# ------------------------------------------------------------------
# Supabase (only used when DATA_MODE=supabase)
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=

# Public key. Newer Supabase projects call it a "publishable" key; older projects
# call the same thing an "anon" key. Set whichever your project shows — either
# name is read, and if both happen to be set the publishable one wins. Both are
# public by design: Row Level Security, not the key, is what protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# This application intentionally does NOT read SUPABASE_SERVICE_ROLE_KEY.
# A service-role key bypasses Row Level Security, and one accidental import
# into client code would leak it. All access goes through the public key plus RLS.
# If a future background job needs it, keep it server-only and re-review the policies.
# SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# Site
# ------------------------------------------------------------------
# Must be the public origin of the deployed site. The account-confirmation and
# password-reset links emailed to users are built from it, so leaving it unset
# emails a link to localhost:3000. Sign-in, sign-out and /auth/callback do not
# read it: they redirect on a relative path, so they always return the visitor
# to the site they were already on.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------
# Payments (server-only)
# ------------------------------------------------------------------
# Which money-mover a supabase-mode build uses. Only "chapa" is implemented.
# Leave it unset in demo mode: the simulator is chosen by DATA_MODE=demo and this
# variable is not read. Setting PAYMENT_PROVIDER=demo_simulated while DATA_MODE is
# supabase is refused on purpose, so a simulated payment can never be presented as
# a real one.
PAYMENT_PROVIDER=chapa

# Chapa's server-side secret key (docs.chapa.global). The name your dashboard shows
# depends on the account: use the secret key, never the public one. Without it the
# checkout call cannot be made and payment is reported as unavailable rather than
# pretending to work.
CHAPA_SECRET_KEY=

# The signing secret Chapa sends webhooks with, used to check an HMAC-SHA256
# signature before a webhook is allowed to change a payment's status. Without it no
# webhook is accepted.
CHAPA_WEBHOOK_SECRET=

# No live payment, webhook or receipt has been exercised against Chapa's API from
# this build. Setting these keys makes the calls possible; it does not make the
# integration tested. See README "Payments, receipts, and reports".

# ------------------------------------------------------------------
# App lock (server-only, optional)
# ------------------------------------------------------------------
# The lock is offered only when ALL of these hold: DATA_MODE=supabase, this secret
# is set, and migration 0008 has been applied. Anything else is a supported state,
# not a broken one: the Settings card then names the missing prerequisite, and the
# unlock screen redirects back rather than inventing a lock it cannot verify.
#
# Signs the cookie that says "this session must unlock before it sees the account
# area". Without it there is no trustworthy grant, so the feature switches itself
# off; the value is never sent to a browser. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A value shorter than 32 characters is refused at read time, not truncated.
APP_LOCK_SECRET=

# The relying-party ID handed to WebAuthn. A credential is bound to it and to the
# site's origin, and passkeys registered under one rp_id cannot be reused under
# another. It must be a bare host name, never a URL: the deployed site's own host
# (omo-net-tab.vercel.app) works, and so does a registrable parent of it
# (example.com for www.example.com) when several subdomains should share passkeys.
#
# REQUIRED IN PRODUCTION. With NODE_ENV=production this variable is the only source of
# the rp id, and the WebAuthn endpoints answer 503 when it is missing or is `localhost`.
# The request's Host header is never consulted there: it is a value the client chooses,
# and a domain taken from it would mean any request that names another host could get a
# credential enrolled for that host or verified against it. Set it to the bare host the
# site is served from:
#   APP_LOCK_RP_ID=omo-net-tab.vercel.app
#
# Outside production it may stay unset, and then the Host of the request that starts the
# ceremony answers — which is what makes `npm run dev` on localhost work. Even there only
# a plain host is accepted: a Host carrying a scheme, a path, a malformed port or an IP
# literal is refused, because reading `https://example.com` as the host `https` is how an
# rp id becomes a string no authenticator will ever assert against.
# APP_LOCK_RP_ID=

# Comma-separated list of origins allowed to assert a WebAuthn ceremony, e.g.
#   APP_LOCK_ALLOWED_ORIGINS=https://omo-net-tab.vercel.app
# WebAuthn verification fails if the assertion's origin is not among the accepted
# ones. This is an exact list, and the request's own Origin is never added to it: a
# ceremony that could name its own origin could name any other site's. Left unset, the
# single origin derived from the rp id is accepted (`https://<rp id>`), which is right
# for one deployment and too narrow the moment a preview URL or a custom domain also has
# to enrol. A Vercel preview deployment cannot share passkeys with production either way:
# the origin differs, so enrolment there is separate.
# APP_LOCK_ALLOWED_ORIGINS=
