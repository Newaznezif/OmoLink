# OmoLink environment variables
# Copy this file to .env.local for local development. Never commit real credentials.

# ------------------------------------------------------------------
# Data mode
# ------------------------------------------------------------------
# "demo"   -> in-memory demo data + local JSON store (no credentials needed)
# "supabase" -> currently unsupported; this build fails closed instead of using demo data
DATA_MODE=demo

# ------------------------------------------------------------------
# Supabase (only used when DATA_MODE=supabase)
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Never expose SUPABASE_SERVICE_ROLE_KEY to the browser. Server-only.

# ------------------------------------------------------------------
# Site
# ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
