# OmoNETAB environment variables
# Copy this file to .env.local for local development. Never commit real credentials.

# ------------------------------------------------------------------
# Data mode
# ------------------------------------------------------------------
# "demo"     -> in-memory demo data, no credentials needed
# "supabase" -> real Supabase Postgres + Supabase Auth (requires both keys below)
# There is no silent fallback: DATA_MODE=supabase without credentials fails the
# first request that touches data rather than showing demo records. The check
# runs when the Supabase client is built (per request), not when the server
# boots, so a misconfigured deployment returns errors instead of starting clean.
DATA_MODE=demo

# ------------------------------------------------------------------
# Supabase (only used when DATA_MODE=supabase)
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# This application intentionally does NOT read SUPABASE_SERVICE_ROLE_KEY.
# A service-role key bypasses Row Level Security, and one accidental import
# into client code would leak it. All access goes through the anon key plus RLS.
# If a future background job needs it, keep it server-only and re-review the policies.
# SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# Site
# ------------------------------------------------------------------
# Must be the public origin of the deployed site. The account-confirmation and
# password-reset links emailed to users are built from it, so leaving it unset
# emails a link to localhost:3000. Sign-in, sign-out and /auth/callback do not
# read it: they redirect on a relative path, so they always return the visitor
# to the site they were already on.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
